{
  "mode": "yolo",
  "granularity": "standard",
  "model_profile": "adaptive",
  "model_overrides": {
    "gsd-project-researcher": "opus",
    "gsd-phase-researcher": "opus",
    "gsd-ui-researcher": "opus",
    "gsd-research-synthesizer": "opus",
    "gsd-roadmapper": "opus",
    "gsd-planner": "opus",
    "gsd-plan-checker": "opus",
    "gsd-executor": "sonnet",
    "gsd-verifier": "sonnet",
    "gsd-integration-checker": "sonnet"
  },
  "workflow": {
    "research": true,
    "plan_check": true,
    "verifier": true,
    "auto_advance": true,
    "nyquist_validation": true,
    "security_enforcement": true,
    "security_asvs_level": 1,
    "security_block_on": "high",
    "discuss_mode": "assumptions",
    "research_before_questions": true
  },
  "planning": {
    "commit_docs": true,
    "search_gitignored": false,
    "sub_repos": []
  },
  "git": {
    "create_tag": false
  },
  "parallelization": {
    "enabled": true,
    "plan_level": true,
    "task_level": false,
    "skip_checkpoints": true,
    "max_concurrent_agents": 10,
    "min_plans_for_parallel": 2
  },
  "gates": {
    "confirm_project": false,
    "confirm_phases": false,
    "confirm_roadmap": false,
    "confirm_breakdown": false,
    "confirm_plan": false,
    "execute_next_plan": false,
    "issues_review": false,
    "confirm_transition": false
  },
  "safety": {
    "always_confirm_destructive": true,
    "always_confirm_external_services": true
  },
  "project_code": "UGC",
  "agent_skills": {},
  "claude_md_path": "./CLAUDE.md"
}
